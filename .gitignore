# =====================================================================
# RAHASIA — jangan pernah di-commit. Pengaman tambahan: .githooks/pre-commit
# (aktifkan sekali per clone: git config core.hooksPath .githooks)
# =====================================================================
# Konfigurasi aplikasi (URL & publishable key Supabase). Contoh: env.example.json
env.json
env.*.json
!env.example.json

# File .env, mis. secret Edge Function untuk `supabase functions serve --env-file`
.env
.env.*
!.env.example
supabase/.env
supabase/functions/.env

# Folder kerja Supabase CLI (project ref, URL pooler)
supabase/.temp/
supabase/.branches/

# Kunci tanda tangan rilis Play Store (upload key) dan sertifikat lain.
# Simpan cadangannya di tempat aman, misalnya password manager.
android/key.properties
*.jks
*.keystore
*.p12
*.pem
*.p8

# Kredensial service account Google/Supabase
service-account*.json
*-service-account.json

# Cadangan git (bundle / mirror) yang tidak sengaja tersimpan di folder proyek
*.bundle
*-backup.git/

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

