#!/bin/sh
# Pengaman rahasia Racik: menolak commit yang memuat file rahasia atau isi
# yang mirip API key / password. Aktifkan sekali per clone:
#
#   git config core.hooksPath .githooks
#
# Kalau yakin itu bukan rahasia (mis. contoh di dokumentasi), commit dengan
# `git commit --no-verify`.

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1. Nama file rahasia
bad_files=$(printf '%s\n' "$staged" \
  | grep -Ei '(\.jks|\.keystore|\.p12|\.pem|\.p8)$|(^|/)key\.properties$|(^|/)env(\.[^/]*)?\.json$|(^|/)\.env($|\.)|service-account[^/]*\.json$' \
  | grep -Ev '(^|/)env\.example\.json$|(^|/)\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "DITOLAK: file rahasia tidak boleh di-commit:" >&2
  printf '  %s\n' $bad_files >&2
  echo "Keluarkan dari staging: git restore --staged <file>" >&2
  exit 1
fi

# 2. Isi yang mirip rahasia (hanya baris yang ditambahkan, file teks)
patterns='sk-or-v1-[A-Za-z0-9]{20,}|sb_secret_[A-Za-z0-9_-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|"type": *"service_account"|(store|key)Password=[^$[:space:]]'
hits=$(git diff --cached -U0 --diff-filter=ACMR --text -- . ':(exclude).githooks/pre-commit' \
  | grep -E '^\+' | grep -Ev '^\+\+\+ ' | grep -En "$patterns" | cut -c1-120)
if [ -n "$hits" ]; then
  echo "DITOLAK: ada isi yang mirip API key, secret, atau password:" >&2
  printf '%s\n' "$hits" >&2
  echo "Pindahkan ke env.json / secret Supabase, lalu commit lagi." >&2
  exit 1
fi
exit 0
