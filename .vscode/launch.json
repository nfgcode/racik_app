{
  // Semua konfigurasi membaca env.json supaya Supabase & OpenRouter terhubung.
  // Tanpa --dart-define-from-file, aplikasi menampilkan layar "Racik belum terhubung ke Supabase".
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Racik",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "toolArgs": ["--dart-define-from-file=env.json"]
    },
    {
      "name": "Racik (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "toolArgs": ["--dart-define-from-file=env.json"]
    }
  ]
}
